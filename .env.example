# ==============================================================
# PM CONTROL TOWER â€” Environment Configuration (template)
# Copy to `.env` and adjust before starting.
# Full reference: docs/01-DEPLOYMENT-GUIDE.md
# ==============================================================

# --- Database (SQLite) -------------------------------------------------
# MUST be an ABSOLUTE path in production (Docker uses file:/app/db/pmct.db).
# Relative paths resolve against prisma/schema.prisma for the CLI but against
# a different directory for the standalone runtime server â€” absolute avoids both.
DATABASE_URL=file:/absolute/path/to/db/pmct.db

# --- Security ----------------------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -hex 32
# REALTIME_SECRET_KEY must equal JWT_SECRET: the realtime gateway verifies the
# same JWTs the API issues for socket authentication.
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
REALTIME_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# Shared secret used by the API to publish events to the realtime gateway
# (POST /emit). Any random string; keep it private to the two services.
REALTIME_SECRET=CHANGE-ME-emit-shared-secret

# --- Realtime gateway (Socket.IO mini service) -------------------------
# Internal address where the Next.js API publishes events. Not exposed publicly.
REALTIME_URL=http://127.0.0.1:3003
REALTIME_PORT=3003

# --- HTTP server (standalone production server) ------------------------
PORT=3000
HOSTNAME=127.0.0.1

# --- Optional ----------------------------------------------------------
# PMO template configuration bootstrap (JSON) â€” see docs/02-ADMIN-GUIDE.md
# PMCT_CONFIG_JSON=
# Public web origin, used by config bootstrap validation
# WEB_ORIGIN=https://pm.example.com

# --- Vercel / PostgreSQL (hosted deploys) ------------------------------
# Local development stays on SQLite above — nothing here changes that.
# On Vercel, attach a Postgres database instead:
#   Vercel dashboard ? Storage ? Create Database ? Postgres (Neon)
# The integration injects DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
# automatically. The Vercel build (vercel.json) then:
#   1. generates prisma/schema.vercel.prisma (provider = "postgresql")
#   2. regenerates the Prisma client for Postgres
#   3. runs prisma db push (schema sync — this repo has no migrations)
#   4. seeds the reference dataset (only when the database is empty)
# Also set JWT_SECRET on Vercel (auth falls back to a dev secret if unset).
# Optional local testing against a hosted DB: put the postgresql:// URL in
# .env.vercel (gitignored) or run:
#   node scripts/vercel-db.mjs setup --url=postgresql://...
# Afterwards restore the local SQLite client:
#   node scripts/vercel-db.mjs restore

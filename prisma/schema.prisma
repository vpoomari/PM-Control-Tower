// --- Dynamic Field Configuration Engine (v3.2) ---
// Admin-defined field dictionary + UI tab mappings. Values are stored on
// Project.customData (Json column keyed by fieldKey). On SQLite Prisma stores
// Json as TEXT; on PostgreSQL the same schema maps to JSONB with no changes.
// dataType uses a String column + app-level enum (FIELD_DATA_TYPES in
// src/lib/engines/custom-fields.ts) because SQLite does not support Prisma
// enums — swap to `enum FieldDataType` verbatim when migrating to PostgreSQL.
model CustomFieldDefinition {
  id          String            @id @default(uuid())
  fieldKey    String            @unique // stable, immutable machine name: business_owner
  name        String            @default("") // friendly field name (defaults to label)
  label       String // display label: Business Owner
  dataType    String            // TEXT | LONG_TEXT | INTEGER | DECIMAL | CURRENCY | PERCENTAGE | DATE | DATETIME | CHECKBOX | SINGLE_SELECT | MULTI_SELECT | USER_LOOKUP | ENTITY_LOOKUP | URL | EMAIL | FORMULA | PHONE
  options     Json? // DROPDOWN / MULTI_SELECT: string[] of choices. ENTITY_LOOKUP: { entity: "project" }
  config      Json? // validation + display rules: { min, max, step, integer, unit, minLength, maxLength, multiline, placeholder, defaultValue, expression }
  description String?
  // --- Dictionary governance (v4.0 Field Dictionary) ---
  categoryId    String?
  category      FieldCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fieldGroup    String? // optional grouping label inside forms/tables
  status        String                  @default("ACTIVE") // ACTIVE | INACTIVE | DEPRECATED | ARCHIVED
  isRequired    Boolean                 @default(false) // global default; assignments may override
  isReadOnly    Boolean                 @default(false) // global default; assignments may override
  isSearchable  Boolean                 @default(true)
  isFilterable  Boolean                 @default(true)
  isSortable    Boolean                 @default(true)
  isReportable  Boolean                 @default(true)
  isExportable  Boolean                 @default(true)
  sensitivity   String                  @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  visibleRolesJson String? // csv of role codes allowed to VIEW the field value (empty = all)
  editableRolesJson String? // csv of role codes allowed to EDIT the field value (empty = all)
  deprecationReason String?
  version       Int                     @default(1)
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?
  isActive      Boolean                 @default(true) // legacy mirror of status === "ACTIVE"
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tabMappings  TabFieldMapping[]
  assignments  ModuleFieldAssignment[]
  values       CustomFieldValue[]
  auditLogs    FieldAuditLog[]

  @@index([status])
  @@index([categoryId])
  @@index([dataType])
}

// ============ FIELD DICTIONARY & DYNAMIC FIELD CONFIGURATION (v4.0) ============
// Define once → reuse across modules → configure per module → store values
// against the correct business record.
//
//   CustomFieldDefinition  (A) GLOBAL FIELD DEFINITION — the reusable dictionary entry
//   ModuleFieldAssignment  (B) MODULE FIELD ASSIGNMENT — how a definition is used in ONE module
//   CustomFieldValue       (C) FIELD VALUE          — typed value against ONE business record
//   FieldAuditLog          — lifecycle + assignment + value-change audit trail
//
// Values are stored in typed columns (valueText/valueNumber/valueDate/valueBool/
// valueJson) so numeric, date, currency and relationship fields stay valid for
// filtering, sorting, reporting and export. SQLite has no Prisma enums, so all
// enum-ish columns are Strings validated app-side (src/lib/engines/field-dictionary.ts).

model FieldCategory {
  id          String   @id @default(cuid())
  key         String   @unique // snake_case: commercial, delivery, compliance
  name        String
  description String?
  color       String? // tailwind-oriented accent token, display only
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fields      CustomFieldDefinition[]
  assignments ModuleFieldAssignment[]

  @@index([isActive, sortOrder])
}

model ModuleFieldAssignment {
  id                String                @id @default(uuid())
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  moduleKey         String // portfolio | program | project | requirement | wbs_node | task | milestone | baseline | resource | timesheet | timesheet_entry | budget_line | evm_period | health_snapshot | risk | issue | assumption | change_request | stage_gate | governance_rule | governance_alert | user | audit_trail
  categoryId        String?
  category          FieldCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  section           String                @default("general") // form section/grouping key
  sortOrder         Int                   @default(100)
  displayLabel      String? // per-module label override (never mutates the global definition)
  isRequired        Boolean               @default(false) // module-level override of the global default
  isReadOnly        Boolean               @default(false)
  isVisible         Boolean               @default(true)
  isInForm          Boolean               @default(true)
  isInTable         Boolean               @default(false)
  isInDetail        Boolean               @default(true)
  isFilterable      Boolean               @default(true)
  isSortable        Boolean               @default(true)
  validationOverridesJson String? // { min, max, minLength, maxLength, required } overrides
  createdById       String?
  createdByName     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  values            CustomFieldValue[]

  @@unique([fieldDefinitionId, moduleKey]) // a field can never be assigned to the same module twice
  @@index([moduleKey, sortOrder])
}

model CustomFieldValue {
  id                String                @id @default(uuid())
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  assignmentId      String?
  assignment        ModuleFieldAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  moduleKey         String
  recordId          String // id of the owning business record
  projectId         String? // optional project scope (for project-scoped modules)
  // ---- typed value columns (exactly one is populated) ----
  valueText         String? // TEXT | LONG_TEXT | EMAIL | URL | PHONE | SINGLE_SELECT | USER_LOOKUP | ENTITY_LOOKUP | DATE(yyyy-mm-dd) | DECIMAL/CURRENCY/PERCENTAGE/INTEGER(formatted)
  valueNumber       Float? // INTEGER | DECIMAL | CURRENCY | PERCENTAGE | FORMULA(numeric)
  valueDate         DateTime? // DATE | DATETIME
  valueBool         Boolean? // CHECKBOX
  valueJson         Json? // MULTI_SELECT: string[] | other structured payloads
  formulaResultJson Json? // FORMULA: { value, error, inputs }
  createdById       String?
  updatedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([fieldDefinitionId, moduleKey, recordId]) // one value per field per record
  @@index([moduleKey, recordId])
  @@index([moduleKey, updatedAt])
  @@index([fieldDefinitionId])
  @@index([projectId])
}

model FieldAuditLog {
  id                String                @id @default(uuid())
  fieldDefinitionId String?
  fieldDefinition   CustomFieldDefinition? @relation(fields: [fieldDefinitionId], references: [id], onDelete: SetNull)
  assignmentId      String?
  moduleKey         String?
  recordId          String?
  action            String // CREATE | UPDATE | DEPRECATE | ACTIVATE | ARCHIVE | DELETE | ASSIGN | UNASSIGN | ASSIGNMENT_UPDATE | VALUE_SET | VALUE_CLEAR | MIGRATE
  summary           String
  beforeJson        String?
  afterJson         String?
  userId            String?
  userName          String?
  role              String?
  ipAddress         String?
  createdAt         DateTime              @default(now())

  @@index([fieldDefinitionId, createdAt])
  @@index([moduleKey, recordId])
  @@index([createdAt])
}

model ProjectTab {
  id          String  @id @default(uuid())
  name        String
  order       Int
  description String? // helper text shown above the form on the project workspace
  fields      TabFieldMapping[]
}

model TabFieldMapping {
  id           String                @id @default(uuid())
  tabId        String
  tab          ProjectTab            @relation(fields: [tabId], references: [id], onDelete: Cascade)
  fieldId      String
  field        CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  displayOrder Int
  isRequired   Boolean               @default(false)
  isReadOnly   Boolean               @default(false) // locked on this tab (value tracked, not edited here)
  fullWidth    Boolean               @default(false) // spans both form columns
  showInReport Boolean               @default(true) // included in field reporting / coverage

  @@unique([tabId, fieldId])
  @@index([tabId, displayOrder])
}

model NamingConvention {
  id        String @id @default(cuid())
  scope     String @unique // fields | entities | projectCode | riskCode | issueCode | changeCode
  style     String @default("snake_case") // snake_case | camelCase | PascalCase | UPPER_SNAKE
  prefix    String @default("")
  suffix    String @default("")
  includeYear Boolean @default(false)
  seqPad    Int    @default(5)
}

model Terminology {
  id          String  @id @default(cuid())
  termKey     String  @unique // project, risk, milestone...
  defaultTerm String
  customTerm  String?
  pluralName  String?
  active      Boolean @default(true)
}

model FeatureFlag {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(false)
  roles   String? // csv of role codes; empty = all
}

model AdminSettings {
  id                   String @id @default("singleton")
  orgName              String @default("dynamiq Solutions")
  confidentialityLabel String @default("CONFIDENTIAL — INTERNAL MANAGEMENT USE ONLY")
  currency             String @default("USD")
  dateFormat           String @default("YYYY-MM-DD")
  prioritizationConfigJson String @default("{}") // executive prioritization: RAG thresholds, alerts, decision categories, presets, KPI defs
  hiddenNavTabsJson    String @default("[]") // admin-configured sidebar visibility: hrefs of nav tabs hidden from ALL users (display-only — routes stay reachable)
}

// ============ IDENTITY & ACCESS (v2.0.0) ============

model IdentityProvider {
  id              String   @id @default(cuid())
  protocol        String   // SAML2 | OIDC
  name            String
  issuer          String
  clientId        String?
  clientSecret    String?
  ssoUrl          String
  idpCertificate  String?
  groupsRoleMappingJson String @default("[]") // [{idpGroup: "PMO Lead", roleCode: "PMO_ADMIN"}]
  status          String   @default("CONFIGURED") // CONFIGURED | CONNECTED (live-tested)
  lastTestAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScimToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  label      String
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
}

// ============ DELIVERY DEPTH: UAT + DOCUMENTS + SCHEDULE SCENARIOS (v2.2.0) ============

model UatCycle {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  status      String   @default("ACTIVE") // ACTIVE | CLOSED
  startDate   DateTime @default(now())
  endDate     DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases       UatCase[]
  @@index([projectId])
}

model UatCase {
  id          String  @id @default(cuid())
  cycleId     String
  title       String
  severity    String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String  @default("NOT_RUN") // NOT_RUN | PASS | FAIL | BLOCKED
  executedBy  String?
  executedAt  DateTime?
  defectRef   String?
  notes       String?
  cycle       UatCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  @@index([cycleId])
}


model ScheduleScenario {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  deltasJson    String   // {taskId: newDurationDays}
  baseFinish    Float
  scenarioFinish Float
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model StrategicObjective {
  id          String   @id @default(cuid())
  name        String
  description String?
  weight      Float    @default(20)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  projects    Project[]
  @@index([order])
}

model BoardPack {
  id                String   @id @default(cuid())
  name              String
  createdBy         String
  executiveSummary  String?
  confidentiality   String   @default("CONFIDENTIAL")
  createdAt         DateTime @default(now())
  pages             BoardPackPage[]
  @@index([createdAt])
}
model BoardPackPage {
  id        String   @id @default(cuid())
  packId    String
  order     Int
  title     String
  reportId  String?
  pack      BoardPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  @@index([packId])
}
model CustomReport {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("CUSTOM")
  componentsJson String @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([createdBy])
}

// ============ AI AGENTS (autonomous workers, activated in Admin → Settings) ============
// AgentProfile holds ONLY per-organisation activation + config; the agent
// definitions themselves are code (src/lib/agents/catalog.ts) — single source
// of truth. Rows are upserted lazily from the catalogue on first read.

model AgentProfile {
  id           String    @id @default(cuid())
  key          String    @unique
  status       String    @default("PAUSED") // ACTIVE | PAUSED
  configJson   String    @default("{}")     // cadence + per-agent thresholds (org-tuned)
  budgetTokens Int       @default(0)        // 0 = unlimited (global token meter still applies)
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Append-only ledger of every agent run: findings, proposed action, approval
// state and outcome. The audit trail for "what did the agent do, and who let it".

model AgentRun {
  id             String    @id @default(cuid())
  agentKey       String
  trigger        String    @default("MANUAL")  // MANUAL | SCHEDULED
  status         String    @default("SUCCESS") // SUCCESS | NO_FINDINGS | FAILED | PENDING_APPROVAL | APPLIED | REJECTED
  summary        String?
  findingsJson   String    @default("[]")
  actionType     String?                      // proposed action (approval-gated agents)
  actionJson     String?                      // validated payload for the apply step
  narrationSource String   @default("HEURISTIC") // AI | HEURISTIC (honest fallback labelling)
  tokens         Int       @default(0)
  durationMs     Int       @default(0)
  actorUserId    String?
  actorName      String?
  errorMessage   String?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())

  @@index([agentKey, createdAt])
  @@index([status])
}

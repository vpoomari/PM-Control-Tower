// ============ ENGAGEMENT: NOTIFICATIONS, INBOX, PLANNER ============

model Notification {
  id         String    @id @default(cuid())
  userId     String
  notifType  String    @default("SYSTEM")
  category   String    @default("SYSTEM")
  title      String
  message    String?
  entityType String?
  entityId   String?
  projectId  String?
  channel    String    @default("IN_APP")
  severity   String    @default("INFO")
  actionUrl  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model InboxItem {
  id          String    @id @default(cuid())
  userId      String
  category    String    @default("ACTION_REQUIRED")
  title       String
  message     String?
  entityType  String?
  entityId    String?
  projectId   String?
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  status      String    @default("OPEN")
  actionUrl   String?
  sourceType  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model PlannerEntry {
  id             String    @id @default(cuid())
  userId         String
  taskId         String?
  projectId      String?
  meetingId      String?
  title          String
  entryType      String    @default("FOCUS")
  date           DateTime
  startTime      String?
  endTime        String?
  durationMins   Int       @default(60)
  priority       String    @default("MEDIUM")
  status         String    @default("PLANNED")
  estimatedHours Float     @default(1)
  notes          String?
  createdAt      DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ============ AUTOMATION ============

model AutomationRule {
  id             String    @id @default(cuid())
  name           String
  description    String?
  triggerType    String
  conditionsJson String?
  actionsJson    String?
  isActive       Boolean   @default(true)
  priority       Int       @default(5)
  executionCount Int       @default(0)
  failureCount   Int       @default(0)
  lastRunAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  executions AutomationExecution[]
}

model AutomationExecution {
  id          String   @id @default(cuid())
  ruleId      String
  projectId   String?
  status      String   @default("SUCCESS")
  triggeredBy String   @default("SYSTEM")
  entityType  String?
  entityId    String?
  inputJson   String?
  outputJson  String?
  error       String?
  durationMs  Int      @default(0)
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

// ============ TEMPLATES ============

model Template {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("PROJECT")
  templateType String?
  description String?
  methodology String?
  industry    String?
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  rating      Float    @default(0)
  tags        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  versions TemplateVersion[]
}

model TemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  version       String
  changelog     String?
  structureJson String?
  status        String   @default("ACTIVE")
  createdBy     String?
  createdAt     DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ============ INTEGRATION HUB ============

model Integration {
  id              String    @id @default(cuid())
  name            String
  category        String
  provider        String?
  description     String?
  status          String    @default("DISCONNECTED")
  authType        String    @default("API_KEY")
  authStatus      String    @default("NOT_CONFIGURED")
  syncDirection   String    @default("OUTBOUND")
  syncFrequency   String    @default("HOURLY")
  lastSyncAt      DateTime?
  errorCount      Int       @default(0)
  retryCount      Int       @default(0)
  lastError       String?
  healthScore     Float     @default(100)
  configJson      String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  credentials IntegrationCredential[]
  events      IntegrationEvent[]

  @@index([category])
}

model IntegrationCredential {
  id            String    @id @default(cuid())
  integrationId String
  label         String
  credType      String    @default("API_KEY")
  maskedValue   String
  encryptedRef  String?
  expiresAt     DateTime?
  rotatedAt     DateTime?
  status        String    @default("ACTIVE")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model IntegrationEvent {
  id            String   @id @default(cuid())
  integrationId String
  direction     String   @default("OUTBOUND")
  eventType     String
  status        String   @default("SUCCESS")
  payload       String?
  response      String?
  error         String?
  durationMs    Int      @default(0)
  attempts      Int      @default(1)
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
}

model WebhookSubscription {
  id             String    @id @default(cuid())
  name           String
  url            String
  events         String
  secretRef      String?
  status         String    @default("ACTIVE")
  authType       String    @default("HMAC_SHA256")
  maxRetries     Int       @default(3)
  deliveryCount  Int       @default(0)
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  lastStatus     String?
  createdBy      String?
  createdAt      DateTime  @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  eventType      String
  payload        String?
  responseCode   Int?
  responseBody   String?
  status         String   @default("SUCCESS")
  attempts       Int      @default(1)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}


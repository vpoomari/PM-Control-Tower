}

model Communication {
  id        String   @id @default(cuid())
  projectId String?
  commType  String   @default("EMAIL")
  subject   String
  audience  String?
  channel   String   @default("IN_APP")
  content   String?
  senderId  String?
  sentAt    DateTime @default(now())
  status    String   @default("SENT")

  @@index([projectId])
}

model Document {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  docType     String?
  category    String?
  url         String?
  version     String   @default("1.0")
  sizeKb      Float    @default(0)
  description String?
  uploadedBy  String?
  uploadedAt  DateTime @default(now())


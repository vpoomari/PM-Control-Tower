// ============ TOWERINTEGRATION HUB ============

// One row per activated tool of the 55-tool ecosystem. Extends the existing
// Integration/Webhook linkage (integrationId links back when a matching
// Integration exists — nothing is de-linked).

model HubConnection {
  id              String    @id @default(cuid())
  toolId          String    @unique          // registry id, e.g. "jira"
  name            String
  category        String                      // HubCategory (6 routing categories)
  status          String    @default("PAUSED") // PAUSED | ACTIVE | DEGRADED | ERROR
  authKind        String    @default("HMAC")  // HMAC | JWT | OAUTH2 | MTLS | NONE
  authStatus      String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | VALID | INVALID
  ingressMode     String    @default("WEBHOOK") // WEBHOOK | POLL | BI_REFRESH | CSV_UPLOAD
  secretRef       String?                    // vault:// reference to HMAC/JWT secret
  secretEnc       String?                    // AES-256-GCM encrypted secret (same vault scheme as AI BYOK)
  configJson      String?                    // base URL, poll cadence, mtls policy…
  // Circuit breaker state (serialized BreakerSnapshot from lib/hub/breaker.ts)
  breakerState    String    @default("CLOSED") // CLOSED | OPEN | HALF_OPEN
  breakerJson     String?                    // full snapshot: failures, retryAtMs, trips…
  // Counters
  ingestedCount   Int       @default(0)
  harmonizedCount Int       @default(0)
  dlqCount        Int       @default(0)
  lastIngestAt    DateTime?
  lastError       String?
  // Existing-linkage pointer (e.g. seeded "Jira Software" Integration row)
  integrationId   String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  events  HubEvent[]
  dlq     HubDeadLetter[]

  @@index([category, status])
}

// One row per payload processed through the pipeline (append-only ledger).
model HubEvent {
  id             String   @id @default(cuid())
  connectionId   String
  toolId         String
  mode           String                      // WEBHOOK | POLL | BI_REFRESH | CSV_UPLOAD
  outcome        String                      // HARMONIZED | PARTIAL | DLQ | REJECTED
  queue          String?                    // processing queue id
  lane           Int      @default(2)
  extracted      Int      @default(0)
  harmonized     Int      @default(0)
  dlqEntries     Int      @default(0)
  durationMs     Int      @default(0)
  reason         String?
  payloadPreview String?                    // truncated raw payload for the feed
  createdAt      DateTime @default(now())

  connection HubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([outcome, createdAt])
}

// Dead Letter Queue — anomalies, missing requireds, validation errors.
// Nothing is dropped: every blocked payload lands here for monitoring + replay.
model HubDeadLetter {
  id             String    @id @default(cuid())
  connectionId   String
  toolId         String
  queue          String?
  severity       String    @default("BLOCKING") // BLOCKING | WARN
  reason         String
  anomalies      String                       // JSON array of anomaly codes
  payloadPreview String?                      // truncated raw record/payload
  itemJson       String?                      // partial UWM item when WARN
  status         String    @default("PENDING") // PENDING | REPLAYED | DISMISSED
  replayCount    Int       @default(0)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  connection HubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status])
  @@index([severity, createdAt])
}


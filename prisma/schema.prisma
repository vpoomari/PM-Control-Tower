// ============ LEADERSHIP REPORTING & EXECUTIVE CONTROL TOWER ============

model ActionItem {
  id             String    @id @default(cuid())
  projectId      String?
  code           String    @unique
  title          String
  description    String?
  ownerName      String?
  ownerEmail     String?
  priority       String    @default("MEDIUM")
  status         String    @default("OPEN")
  source         String    @default("LEADERSHIP")
  relatedType    String?
  relatedCode    String?
  escalationLevel String   @default("NONE")
  raisedAt       DateTime  @default(now())
  dueDate        DateTime?
  completedAt    DateTime?
  raisedByName   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
  @@index([status, dueDate])
}

model ProjectKpi {
  id              String    @id @default(cuid())
  projectId       String?
  code            String    @unique
  name            String
  category        String    @default("KPI")
  unit            String    @default("%")
  targetValue     Float     @default(0)
  currentValue    Float     @default(0)
  baselineValue   Float?
  expectedBenefit String?
  actualBenefit   String?
  status          String    @default("ON_TRACK")
  measurementDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
}

model ReportSnapshot {
  id              String   @id @default(cuid())
  scope           String   @default("PORTFOLIO")
  projectId       String?
  projectCode     String?
  title           String
  periodStart     DateTime?
  periodEnd       DateTime?
  version         Int      @default(1)
  generatedById   String?
  generatedByName String?
  headlineJson    String?
  payloadJson     String?
  createdAt       DateTime @default(now())

  @@index([scope, createdAt])
  @@index([projectId])
}

model ReportSchedule {
  id             String    @id @default(cuid())
  name           String
  frequency      String    @default("WEEKLY")
  scope          String    @default("PORTFOLIO")
  projectId      String?
  sections       String?
  recipients     String?
  deliveryChannel String   @default("IN_APP")
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastRunSummary String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, nextRunAt])
}

// ============ INTEGRITY LAYER ============
// Freshness (honest staleness), Evidence (tamper-evident bundles), Monte Carlo
// (seeded probabilistic forecasting), Calibration (say/do memory), Scenarios
// (branch & merge sandbox), AI actions (draft-only, human-approved), Benefits.

model FreshnessMetric {
  id                  String   @id @default(cuid())
  projectId           String
  feed                String   // timesheets | ledger | tasks | raid | gates
  lastUpdate          DateTime
  expectedCadenceDays Int      @default(7)
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, feed])
  @@index([projectId])
}

model EvidenceBundle {
  id            String    @id @default(cuid())
  projectId     String
  createdBy     String
  createdByName String
  docCount      Int
  manifestHash  String
  status        String    @default("VALID") // VALID | TAMPERED
  verifiedAt    DateTime?
  manifestJson  String
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TaskEstimate {
  taskId       String   @id
  optimistic   Float
  likely       Float
  pessimistic  Float
  distribution String   @default("PERT") // PERT | TRIANGULAR
  updatedAt    DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model SimulationRun {
  id          String   @id @default(cuid())
  status      String   @default("COMPLETE") // QUEUED | RUNNING | COMPLETE | FAILED (async worker)
  error       String?
  projectId   String
  seed        Int
  iterations  Int
  stale       Boolean  @default(false)
  resultsJson String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CalibrationFactor {
  id         String   @id @default(cuid())
  scopeType  String   // team | workType | project
  scopeId    String
  label      String
  factor     Float
  sampleSize Int
  mad        Float
  computedAt DateTime @default(now()) @updatedAt

  @@unique([scopeType, scopeId])
  @@index([scopeType])
}

model Scenario {
  id              String    @id @default(cuid())
  name            String
  projectId       String
  status          String    @default("SANDBOX") // SANDBOX | MERGED | DISCARDED
  createdBy       String
  createdByName   String
  snapshotJson    String
  overridesJson   String    @default("{}")
  diffJson        String?
  changeRequestId String?
  createdAt       DateTime  @default(now())
  mergedAt        DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AiAction {
  id            String    @id @default(cuid())
  type          String    // STEERING_PACK | REPLAN_PROPOSAL
  projectId     String?
  title         String
  contentJson   String
  status        String    @default("DRAFTED") // DRAFTED | EDITED | APPROVED | REJECTED
  trigger       String?
  humanReviewer String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, type])
}

model BenefitProfile {
  id                String    @id @default(cuid())
  projectId         String
  name              String
  type              String    // REVENUE | COST_SAVING | CAPACITY | KPI
  baselineValue     Float
  targetValue       Float
  timeframeMonths   Int
  owner             String
  reviewCadenceDays Int       @default(30)
  active            Boolean   @default(false)
  activatedAt       DateTime?
  createdAt         DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actuals  BenefitActual[]
  reviews  BenefitReview[]

  @@index([projectId])
}

model BenefitActual {
  id        String   @id @default(cuid())
  profileId String
  period    DateTime
  value     Float
  source    String?
  createdAt DateTime @default(now())

  profile BenefitProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, period])
}

model BenefitReview {
  id         String   @id @default(cuid())
  profileId  String
  date       DateTime
  status     String   @default("ON_TRACK") // ON_TRACK | AT_RISK | MISSED
  commentary String?
  createdAt  DateTime @default(now())

  profile BenefitProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SystemConfig {
  id                   String   @id @default("singleton")
  freshnessWarn        Float    @default(1.0)
  freshnessDegrade     Float    @default(1.5)
  freshnessCritical    Float    @default(2.5)
  freshnessGraceHours  Int      @default(24)
  updatedAt            DateTime @updatedAt
}

// ============ TECHNOLOGY & ARCHITECTURE (v1.3.0) ============

model TechApplication {
  id                  String   @id @default(cuid())
  name                String
  category            String   @default("APPLICATION") // APPLICATION | PLATFORM | INFRASTRUCTURE | API
  businessCriticality String   @default("MEDIUM") // LOW | MEDIUM | HIGH | MISSION_CRITICAL
  lifecycleStatus     String   @default("ACTIVE") // PLANNED | ACTIVE | LEGACY | SUNSET | RETIRED
  cloudHosted         Boolean  @default(false)
  owner               String?
  version             String?
  healthScore         Int      @default(80)
  businessUnits       String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  debts    TechnicalDebt[]
  releases TechRelease[]

  @@index([lifecycleStatus])
}

model TechTechnology {
  id              String    @id @default(cuid())
  name            String
  category        String // LANGUAGE | FRAMEWORK | DATABASE | CLOUD | TOOL
  version         String?
  lifecycleStatus String    @default("ACTIVE") // ACTIVE | DEPRECATED | UNSUPPORTED
  supportEndsAt   DateTime?
  usedByCount     Int       @default(0)

  @@index([lifecycleStatus])
}

model TechnicalDebt {
  id            String  @id @default(cuid())
  applicationId String?
  title         String
  severity      String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  estimateHours Float   @default(0)
  status        String  @default("OPEN") // OPEN | PLANNED | RESOLVED
  notes         String?
  createdAt     DateTime @default(now())

  application TechApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([status])
}

model TechRelease {
  id            String   @id @default(cuid())
  applicationId String
  version       String
  releasedAt    DateTime
  status        String   @default("DEPLOYED") // PLANNED | DEPLOYED | ROLLED_BACK
  deployments   Int      @default(1)
  leadTimeDays  Float    @default(0)

  application TechApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([releasedAt])
}

// ============ AI LEARNING MEMORY (v1.3.2) ============

model AiMemory {
  id            String   @id @default(cuid())
  userId        String
  question      String
  answerSummary String?
  topic         String?
  feedback      String   @default("NONE") // POSITIVE | NEGATIVE | NONE
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([topic])
}

model AiKnowledge {
  id      String   @id @default(cuid())
  day     DateTime
  kind    String // PATTERN | PREFERENCE | CORRECTION
  content String
  weight  Float    @default(1)
  source  String   @default("DISTILLED")

  @@unique([day, content])
  @@index([day])
}

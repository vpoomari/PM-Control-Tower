// PM CONTROL TOWER — Enterprise Data Model (Single Source of Truth)
// SQLite sandbox profile: enums modeled as String constants (see src/lib/constants.ts),
// JSON payloads serialized to String columns. Production (Render PostgreSQL) uses the
// same model with native enums/JSON — see documentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY & ACCESS ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  title         String?
  department    String?
  phone         String?
  avatarColor   String    @default("#1e3a5f")
  avatarUrl     String?
  isActive      Boolean   @default(true)
  mfaEnabled  Boolean @default(false)
  mfaSecret   String?
  externalId  String?
  authSource  String   @default("LOCAL") // LOCAL | OIDC | SAML2
  isSuperAdmin  Boolean   @default(false)
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userRoles     UserRole[]
  timesheetApprovals Timesheet[] @relation("TimesheetApprover")
  inboxItems    InboxItem[]
  notifications Notification[]
  plannerEntries PlannerEntry[]
  auditEvents   AuditEvent[]
  ownedProjects Project[]  @relation("ProjectOwner")
  assignedTasks Task[]     @relation("TaskAssignee")
  aiExecutions  AIExecution[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  category    String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ============ PORTFOLIO HIERARCHY ============

model Portfolio {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String
  description        String?
  status             String    @default("ACTIVE")
  ownerId            String?
  strategicObjective String?
  budgetTarget       Float     @default(0)
  actualCost         Float     @default(0)
  forecastCost       Float     @default(0)
  currency           String    @default("USD")
  startDate          DateTime?
  endDate            DateTime?
  healthScore        Float     @default(100)
  ragStatus          String    @default("GREEN")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  programs           Program[]
  projects           Project[]
}

model Program {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  description  String?
  portfolioId  String
  ownerId      String?
  status       String    @default("ACTIVE")
  budget       Float     @default(0)
  actualCost   Float     @default(0)
  forecastCost Float     @default(0)
  healthScore  Float     @default(100)
  ragStatus    String    @default("GREEN")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  projects  Project[]
}

model Project {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  description      String?
  portfolioId      String?
  programId        String?
  ownerId          String?
  managerId        String?
  sponsorId        String?
  status           String    @default("DRAFT")
  priority         String    @default("MEDIUM")
  phase            String    @default("INITIATION")
  methodology      String    @default("HYBRID")
  riskLevel        String    @default("MEDIUM")
  billingType      String    @default("NON_BILLABLE")
  currency         String    @default("USD")
  startDate        DateTime?
  endDate          DateTime?
  baselineStart    DateTime?
  baselineFinish   DateTime?
  baselineBudget   Float     @default(0)
  currentBudget    Float     @default(0)
  actualCost       Float     @default(0)
  forecastCost     Float     @default(0)
  plannedHours     Float     @default(0)
  actualHours      Float     @default(0)
  progress         Float     @default(0)
  healthScore      Float     @default(100)
  ragStatus        String    @default("GREEN")
  charter          String?
  objectives       String?
  successCriteria  String?
  statusDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  portfolio        Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  program          Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  owner            User?      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  wbsNodes         WBSNode[]
  requirements     Requirement[]
  tasks            Task[]
  dependencies     Dependency[]
  milestones       Milestone[]
  baselines        Baseline[]
  calendar         ProjectCalendar?
  assignments      Assignment[]
  timesheetEntries TimesheetEntry[]
  budgetLines      BudgetLine[]
  evmPeriods       EvmPeriod[]
  risks            Risk[]
  issues           Issue[]
  assumptions      Assumption[]
  changeRequests   ChangeRequest[]
  stageGates       StageGate[]
  healthSnapshots  ProjectHealthSnapshot[]
  forecasts        ProjectForecast[]
  deliverables     Deliverable[]
  qualityRecords   QualityRecord[]
  alertEvents      AlertEvent[]
  inboxItems       InboxItem[]
  plannerEntries   PlannerEntry[]
  freshnessMetrics FreshnessMetric[]
  evidenceBundles  EvidenceBundle[]
  simulationRuns   SimulationRun[]
  scenarios        Scenario[]
  aiActions        AiAction[]
  benefitProfiles  BenefitProfile[]
  customFieldsJson String?
  // Dynamic Field Configuration Engine — admin-defined field values keyed by fieldKey
  customData       Json? // keyed by fieldKey; app uses `?? {}` (SQLite rejects Json defaults)
  strategicObjectiveId String?
  strategicObjective StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id], onDelete: SetNull)
  projectScore     ProjectScore?
  uatCycles        UatCycle[]
  scheduleScenarios ScheduleScenario[]
  // Command Center expansion (v3.0)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  epics            Epic[]
  sprints          Sprint[]
  rfis             Rfi[]
  dailyLogs        DailyLog[]
  punchListItems   PunchListItem[]
  invoices         Invoice[]
  expenses         Expense[]
  feedbackPosts    FeedbackPost[]
  roadmapItems     RoadmapItem[]
  boardThreads     BoardThread[]
}

// ============ COMMAND CENTER EXPANSION (v3.0) ============

// --- Agile delivery: epics, sprints, story points on Task ---
model Epic {
  id            String   @id @default(cuid())
  projectId     String
  code          String
  name          String
  colorHex      String   @default("#2563eb")
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | DONE
  businessValue String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Sprint {
  id              String    @id @default(cuid())
  projectId       String
  name            String
  goal            String?
  status          String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  startDate       DateTime?
  endDate         DateTime?
  committedPoints Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

// ============ PLANNING: SCOPE → WBS → TASKS ============

model WBSNode {
  id           String   @id @default(cuid())
  projectId    String
  parentId     String?
  code         String
  name         String
  description  String?
  nodeType     String   @default("WORK_PACKAGE")
  level        Int      @default(1)
  orderIndex   Int      @default(0)
  ownerName    String?
  plannedHours Float    @default(0)
  plannedCost  Float    @default(0)
  actualHours  Float    @default(0)
  actualCost   Float    @default(0)
  progress     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      WBSNode?   @relation("WBSTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    WBSNode[]  @relation("WBSTree")
  tasks       Task[]
  requirements Requirement[]

  @@index([projectId])
  @@index([parentId])
}

model Requirement {
  id                 String   @id @default(cuid())
  projectId          String
  wbsId              String?
  reqCode            String
  title              String
  description        String?
  reqType            String   @default("FUNCTIONAL")
  priority           String   @default("MEDIUM")
  status             String   @default("DRAFT")
  acceptanceCriteria String?
  source             String?
  ownerName          String?
  effortEstimate     Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs     WBSNode? @relation(fields: [wbsId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Task {
  id             String    @id @default(cuid())
  projectId      String
  wbsId          String?
  parentId       String?
  code           String
  name           String
  description    String?
  status         String    @default("NOT_STARTED")
  priority       String    @default("MEDIUM")
  criticality    String    @default("MEDIUM")
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Float     @default(1)
  progress       Float     @default(0)
  plannedHours   Float     @default(0)
  actualHours    Float     @default(0)
  remainingHours Float     @default(0)
  plannedCost    Float     @default(0)
  actualCost     Float     @default(0)
  assigneeId     String?
  // --- Automated e-mail engine (prioritized dashboard) -----------------
  // dueTodayEmailedAt: last time the "Due Today" trigger fired for this task
  //                    (one single e-mail per reached due date — idempotent per day).
  // overdueEmailedAt : last time the daily overdue escalation fired; refreshed
  //                    every day until status hits COMPLETED / CANCELLED / ON_HOLD.
  dueTodayEmailedAt DateTime?
  overdueEmailedAt  DateTime?
  isCritical     Boolean   @default(false)
  isSummary      Boolean   @default(false)
  earliestStart  DateTime?
  earliestFinish DateTime?
  latestStart    DateTime?
  latestFinish   DateTime?
  totalFloat     Float     @default(0)
  freeFloat      Float     @default(0)
  constraintType String    @default("ASAP")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs         WBSNode? @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  parent      Task?    @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Task[]   @relation("TaskTree")
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  estimate     TaskEstimate?
  predecessors Dependency[] @relation("DependencySuccessor")
  successors  Dependency[] @relation("DependencyPredecessor")
  entries     TimesheetEntry[]
  plannerEntries PlannerEntry[]
  assignments Assignment[]
  // Agile (Command Center v3.0)
  epic        Epic?    @relation(fields: [epicId], references: [id], onDelete: SetNull)
  sprint      Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId      String?
  sprintId    String?
  storyPoints Float    @default(0)
  backlogOrder Int     @default(0)
  constraintDate DateTime?
  deadline      DateTime?

  @@index([projectId])
  @@index([wbsId])
  @@index([assigneeId])
}

model Dependency {
  id             String @id @default(cuid())
  projectId      String
  predecessorId  String
  successorId    String
  depType        String @default("FS")
  lagDays        Float  @default(0)
  isExternal     Boolean @default(false)
  externalRef    String?
  createdAt      DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor Task    @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task    @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([predecessorId])
  @@index([successorId])
}

model Milestone {
  id           String    @id @default(cuid())
  projectId    String
  wbsId        String?
  code         String
  name         String
  description  String?
  dueDate      DateTime?
  baselineDate DateTime?
  status       String    @default("PENDING")
  isCritical   Boolean   @default(false)
  gateId       String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Baseline {
  id             String    @id @default(cuid())
  projectId      String
  version        Int       @default(1)
  name           String
  description    String?
  status         String    @default("DRAFT")
  baselineStart  DateTime?
  baselineFinish DateTime?
  baselineHours  Float     @default(0)
  baselineCost   Float     @default(0)
  snapshotJson   String?
  createdBy      String?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// PM CONTROL TOWER — Working-time calendar per project (controls scheduling math).
// workingDays: JSON array of ISO day numbers Mon=1..Sun=7 that count as working days.
// hoursPerDay: contracted working hours in an ordinary working day.
// holidays:    JSON array of ISO dates ("2026-12-25") that are non-working exceptions.
model ProjectCalendar {
  id           String  @id @default(cuid())
  projectId    String  @unique
  workingDays  String  @default("[1,2,3,4,5]")
  hoursPerDay  Float   @default(8)
  holidays     String  @default("[]")
  calendarName String  @default("Standard")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============ EXECUTE: RESOURCES, TIMESHEETS ============

model Resource {
  id                   String    @id @default(cuid())
  userId               String?
  employeeCode         String    @unique
  name                 String
  email                String
  title                String?
  department           String?
  resourceType         String    @default("EMPLOYEE")
  seniority            String    @default("MID")
  primarySkill         String?
  skills               String?
  capacityHoursPerWeek Float     @default(40)
  costRate             Float     @default(0)
  billableRate         Float     @default(0)
  currency             String    @default("USD")
  availabilityStatus   String    @default("AVAILABLE")
  location             String?
  managerName          String?
  avatarUrl            String?   // bundled /avatars/avatar-NN.png (whitelist), null = linked-user avatar / generated fallback
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  assignments Assignment[]
  timesheets  Timesheet[] @relation("TimesheetOwner")
}

model Assignment {
  id                String    @id @default(cuid())
  projectId         String
  resourceId        String
  taskId            String?
  role              String?
  allocationPercent Float     @default(100)
  plannedHours      Float     @default(0)
  actualHours       Float     @default(0)
  startDate         DateTime?
  endDate           DateTime?
  status            String    @default("ACTIVE")
  billable          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([resourceId])
}

model Timesheet {
  id              String    @id @default(cuid())
  resourceId      String
  userId          String?
  weekStart       DateTime
  weekEnd         DateTime
  status          String    @default("DRAFT")
  totalHours      Float     @default(0)
  regularHours    Float     @default(0)
  overtimeHours   Float     @default(0)
  billableHours   Float     @default(0)
  nonBillableHours Float    @default(0)
  leaveHours      Float     @default(0)
  holidayHours    Float     @default(0)
  comments        String?
  approverId      String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectionReason String?
  lockedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resource Resource @relation("TimesheetOwner", fields: [resourceId], references: [id], onDelete: Cascade)
  approver User?    @relation("TimesheetApprover", fields: [approverId], references: [id], onDelete: SetNull)
  entries  TimesheetEntry[]

  @@unique([resourceId, weekStart])
  @@index([status])
}

model TimesheetEntry {
  id              String   @id @default(cuid())
  timesheetId     String
  entryDate       DateTime
  projectId       String?
  programId       String?
  workstream      String?
  wbsId           String?
  taskId          String?
  activity        String?
  startTime       String?
  endTime         String?
  breakMinutes    Float    @default(0)
  hours           Float    @default(0)
  regularHours    Float    @default(0)
  overtimeHours   Float    @default(0)
  billableHours   Float    @default(0)
  nonBillableHours Float   @default(0)
  entryType       String   @default("WORK")
  billable        Boolean  @default(true)
  comments        String?
  createdAt       DateTime @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([projectId])
  @@index([taskId])
}

model Approval {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  projectId   String?
  approvalType String   @default("TIMESHEET")
  requesterId String?
  approverId  String?
  status      String    @default("PENDING")
  decision    String?
  decisionDate DateTime?
  comments    String?
  level       Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([status])
}

// ============ CONTROL: FINANCIALS, EVM, HEALTH ============

model BudgetLine {
  id             String   @id @default(cuid())
  projectId      String
  category       String   @default("LABOR")
  name           String
  baselineAmount Float    @default(0)
  currentAmount  Float    @default(0)
  actualAmount   Float    @default(0)
  forecastAmount Float    @default(0)
  period         String?
  vendorId       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model EvmPeriod {
  id               String   @id @default(cuid())
  projectId        String
  statusDate       DateTime
  periodStart      DateTime?
  periodEnd        DateTime?
  bac              Float    @default(0)
  pv               Float    @default(0)
  ev               Float    @default(0)
  ac               Float    @default(0)
  cpi              Float    @default(1)
  spi              Float    @default(1)
  eac              Float    @default(0)
  etc              Float    @default(0)
  vac              Float    @default(0)
  tcpi             Float    @default(1)
  costVariance     Float    @default(0)
  scheduleVariance Float    @default(0)
  percentComplete  Float    @default(0)
  source           String   @default("CALCULATED")
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, statusDate])
}

model ProjectHealthSnapshot {
  id                  String   @id @default(cuid())
  projectId           String
  capturedAt          DateTime @default(now())
  healthScore         Float    @default(100)
  ragStatus           String   @default("GREEN")
  cpi                 Float    @default(1)
  spi                 Float    @default(1)
  costVariance        Float    @default(0)
  scheduleVariance    Float    @default(0)
  eac                 Float    @default(0)
  bac                 Float    @default(0)
  openRisks           Int      @default(0)
  openIssues          Int      @default(0)
  overdueMilestones   Int      @default(0)
  resourceUtilization Float    @default(0)
  triggeredBy         String   @default("SYSTEM")
  notes               String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, capturedAt])
}

model ProjectForecast {
  id                 String   @id @default(cuid())
  projectId          String
  period             String
  forecastCost       Float    @default(0)
  forecastHours      Float    @default(0)
  forecastFinishDate DateTime?
  confidence         String   @default("MEDIUM")
  basis              String   @default("EVM")
  createdAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, period])
}

// ============ CONTROL: RAID ============

model Risk {
  id                 String    @id @default(cuid())
  projectId          String
  code               String
  title              String
  description        String?
  category           String    @default("TECHNICAL")
  probability        Int       @default(3)
  impact             Int       @default(3)
  score              Int       @default(9)
  severity           String    @default("MEDIUM")
  status             String    @default("OPEN")
  ownerName          String?
  responseStrategy   String    @default("MITIGATE")
  mitigation         String?
  contingency        String?
  residualProbability Int      @default(3)
  residualImpact     Int       @default(3)
  escalationLevel    String    @default("NONE")
  identifiedAt       DateTime  @default(now())
  dueDate            DateTime?
  closedAt           DateTime?
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Issue {
  id              String    @id @default(cuid())
  projectId       String
  code            String
  title           String
  description     String?
  category        String    @default("TECHNICAL")
  priority        String    @default("MEDIUM")
  severity        String    @default("MEDIUM")
  status          String    @default("OPEN")
  ownerName       String?
  raisedBy        String?
  impact          String?
  resolution      String?
  escalationLevel String    @default("NONE")
  raisedAt        DateTime  @default(now())
  dueDate         DateTime?
  resolvedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Assumption {
  id            String    @id @default(cuid())
  projectId     String
  code          String
  description   String
  rationale     String?
  impactIfFalse String?
  status        String    @default("VALID")
  ownerName     String?
  validationDate DateTime?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============ CONTROL: CHANGE, GATES, GOVERNANCE ============

model ChangeRequest {
  id                String    @id @default(cuid())
  projectId         String
  code              String
  title             String
  description       String?
  reason            String?
  category          String    @default("SCOPE")
  requesterId       String?
  requesterName     String?
  ownerId           String?
  impactHours       Float     @default(0)
  impactCost        Float     @default(0)
  scheduleImpactDays Float    @default(0)
  riskImpact        String    @default("LOW")
  status            String    @default("DRAFT")
  decision          String?
  decisionDate      DateTime?
  decidedBy         String?
  dueDate           DateTime?
  priority          String    @default("MEDIUM")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model StageGate {
  id             String    @id @default(cuid())
